{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "interstellar",
  "main": "dist/.runtime/worker.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "services": [{ "binding": "PC_BACKEND", "service": "interstellar" }],
  "browser": { "binding": "BROWSER" },
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "20260924", "simple": { "limit": 10, "period": 60 } },
    { "name": "PC_RATE_LIMITER", "namespace_id": "20260930", "simple": { "limit": 10, "period": 60 } }
  ],
  "durable_objects": { "bindings": [
    { "name": "DISCORD_ASSETS", "class_name": "DiscordAssets" },
    { "name": "VIRTUAL_PC", "class_name": "VirtualPC" }
  ] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordAssets"] },
    { "tag": "v2", "new_sqlite_classes": ["VirtualPC"] }
  ],
  "build": { "command": "npm run build && node src/bundle-worker.js" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
